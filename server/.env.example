# Copiá este archivo a server/.env y completá los valores. NUNCA subas .env a git.

PORT=3001
# Origen(es) permitidos por CORS, separados por coma. En producción: la URL de tu front.
CLIENT_ORIGIN=http://localhost:5173

# --- WhatsApp Cloud API (Meta) ---
# Token permanente del usuario del sistema (Meta Business > Usuarios del sistema)
WHATSAPP_TOKEN=
# ID del número de teléfono de la API (no es el número en sí)
WHATSAPP_PHONE_NUMBER_ID=
# TU número que recibe los turnos, con código de país y sin + ni espacios. Ej: 5493476123456
# También se usa para el fallback wa.me.
WHATSAPP_DESTINO=
# Nombre e idioma del template aprobado en Meta (ver src/whatsappTemplate.ts)
WHATSAPP_TEMPLATE_NAME=nuevo_turno
WHATSAPP_TEMPLATE_LANG=es_AR
GRAPH_API_VERSION=v21.0